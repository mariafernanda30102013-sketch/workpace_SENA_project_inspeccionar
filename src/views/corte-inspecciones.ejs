                            <td>
                                Carlos Ruiz
                            </td>

                            <td>
                                Periódica
                            </td>

                            <td>
                                $25.000
                            </td>

                            <td>
                                $0
                            </td>

                            <td>
                                $25.000
                            </td>

                            <td>
                                No conforme
                            </td>

                        </tr>


                        <tr>

                            <td>
                                INF-004
                            </td>

                            <td>
                                Laura Díaz
                            </td>

                            <td>
                                Periódica
                            </td>

                            <td>
                                $25.000
                            </td>

                            <td>
                                $25.000
                            </td>

                            <td>
                                $0
                            </td>

                            <td>
                                Anulada
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>


        <!-- BOTONES -->
        <div class="text-center mb-5">

            <button
                type="button"
                class="btn btn-primary me-2"
                onclick="window.print()"
            >
                Imprimir corte
            </button>

            <a
                href="/consulta-inspecciones"
                class="btn btn-secondary"
            >
                Volver a consultas
            </a>

        </div>

    </main>


    <%- include('partials/footer') %>

</body>

</html>