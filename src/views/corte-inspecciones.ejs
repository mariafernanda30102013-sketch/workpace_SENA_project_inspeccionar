                </div>


                <div class="col-md-4 mb-3">

                    <strong>Fecha final</strong>

                    <p>
                        30/09/2026
                    </p>

                </div>

            </div>

        </div>


        <!-- RESUMEN DE VISITAS -->
        <div class="card p-4 mb-4">

            <h3 class="mb-4">
                Resumen de visitas
            </h3>

            <div class="row text-center">

                <div class="col-md-4 mb-3">

                    <h5>
                        Visitas realizadas
                    </h5>

                    <h2>
                        25
                    </h2>

                </div>


                <div class="col-md-4 mb-3">

                    <h5>
                        Periódicas
                    </h5>

                    <h2>
                        20
                    </h2>

                </div>


                <div class="col-md-4 mb-3">

                    <h5>
                        Comerciales
                    </h5>

                    <h2>
                        5
                    </h2>

                </div>


                <div class="col-md-4 mb-3">

                    <h5>
                        Anuladas
                    </h5>

                    <h2>
                        2
                    </h2>

                </div>


                <div class="col-md-4 mb-3">

                    <h5>
                        Conformes
                    </h5>

                    <h2>
                        21
                    </h2>

                </div>


                <div class="col-md-4 mb-3">

                    <h5>
                        No conformes
                    </h5>

                    <h2>
                        2
                    </h2>

                </div>

            </div>

        </div>


        <!-- RESUMEN ECONÓMICO -->
        <div class="card p-4 mb-4">

            <h3 class="mb-4">
                Resumen económico
            </h3>

            <div class="row text-center">

                <div class="col-md-4">

                    <h5>
                        Total generado
                    </h5>

