                </div>


                <div class="col-md-4">

                    <h5>
                        Saldo pendiente
                    </h5>

                    <h3>
                        $75.000
                    </h3>

                </div>

            </div>

        </div>


        <!-- DETALLE DE INSPECCIONES -->
        <div class="card p-4 mb-5">

            <h3 class="mb-4">
                Detalle de inspecciones
            </h3>

            <div class="table-responsive">

                <table class="table table-bordered">

