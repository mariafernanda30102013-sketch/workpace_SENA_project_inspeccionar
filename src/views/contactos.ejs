<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <title>
        <%= etiqueta %>
    </title>
    <%- include('partials/head') %>

</head>

<body>
    <%- include('partials/navigation') %>

        <!--Creacion de formulario-->

        <div class="container vh-100 d-flex justify-content-center align-items-center">
            <!--crea una tarjeta de boostraps para contener el formulario b-dark es para que el fondo del formulario sea de color oscuro-->
            <div class="card bg-dark text-white text-center">

                <div class="card-header">
                    <!--se crea la cabecera de la tarjeta-->
                    <h3 class="justify-content align-items-center">Escribenos</h3>
                    <div class="card-body text-star">
                        <form>
                            <div class="mb-3">
                                <label for="Nombre"> Nombre "Requerido"</label>
                                <input type="text" placeholder="Nombre Completo" class="form-control">
                            </div>

                            <div class="mb-3">
                                <label for="Nombre">correo electronico "Requerido"</label>
                                <input type="email" placeholder="correo electronico" class="form-control">
                            </div>

                            <div class="mb-3">
                                <label for="Nombre"> Asunto "Requerido"</label>
                                <input type="text" placeholder="Asunto" class="form-control">
                            </div>

                            <div class="mb-3">
                                <label for="Nombre"> Mensaje "Requerido"</label>
                                <textarea name="mensaje" rows="3" class="form-control"
                                    placeholder="Por favor escriba su mensaje">

                                </textarea>

                            </div>

                            <button type="submit">
                                Enviar
                            </button>

                            <button type="reset">
                                Limpiar
                            </button>


                        </form>

                    </div>

                </div>
            </div>
        </div>


<%- include('partials/footer') %>
</body>

</html>