<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <title>
        <%= etiqueta %>
    </title>
    <%- include('partials/head') %>

</head>

<body>
    <%- include('partials/navegation') %>
      
        <!-- Formulario de contacto -->
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-6">

                    <div class="card shadow-lg border-0">

                        <!-- Encabezado -->
                        <div class="card-header text-center py-4">
                            <h2 class="mb-2">Contáctanos</h2>
                            <p class="mb-0">
                                Estamos aquí para ayudarte
                            </p>
                        </div>

                        <!-- Cuerpo del formulario -->
                        <div class="card-body p-4">

                            <form>

                                <!-- Nombre -->
                                <div class="mb-3">
                                    <label for="nombre" class="form-label">
                                        Nombre completo
                                    </label>

                                    <input type="text" id="nombre" name="nombre" class="form-control"
                                        placeholder="Ingrese su nombre completo" required>
                                </div>

                                <!-- Teléfono -->
                                <div class="mb-3">
                                    <label for="telefono" class="form-label">
                                        Teléfono
                                    </label>

                                    <input type="tel" id="telefono" name="telefono" class="form-control"
                                        placeholder="Ingrese su número de teléfono" required>
                                </div>

                                <!-- Correo -->
                                <div class="mb-3">
                                    <label for="correo" class="form-label">
                                        Correo electrónico
                                    </label>

                                    <input type="email" id="correo" name="correo" class="form-control"
                                        placeholder="ejemplo@correo.com" required>
                                </div>

                                <!-- Tipo de consulta -->
                                <div class="mb-3">
                                    <label for="servicio" class="form-label">
                                        Tipo de consulta
                                    </label>

                                    <select id="servicio" name="servicio" class="form-select" required>
                                        <option value="" selected disabled>
                                            Seleccione una opción
                                        </option>

                                        <option value="inspeccion">
                                            Inspección de gas
                                        </option>

                                        <option value="certificacion">
                                            Certificación
                                        </option>

                                        <option value="visita">
                                            Solicitar una visita
                                        </option>

                                        <option value="informacion">
                                            Solicitar información
                                        </option>

                                        <option value="otro">
                                            Otro
                                        </option>
                                    </select>
                                </div>

                                <!-- Mensaje -->
                                <div class="mb-4">
                                    <label for="mensaje" class="form-label">
                                        Mensaje
                                    </label>

                                    <textarea id="mensaje" name="mensaje" rows="5" class="form-control"
                                        placeholder="Escriba aquí su mensaje..." required></textarea>
                                </div>

                                <!-- Botones -->
                                <div class="d-flex justify-content-center gap-2">

                                    <button type="submit" class="btn btn-danger px-4">
                                        Enviar mensaje
                                    </button>

                                    <button type="reset" class="btn btn-secondary px-4">
                                        Limpiar
                                    </button>

                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>
        </div>


        </div>

        </div>
        </div>
        </div>


        <%- include('partials/footer') %>
</body>

</html>