<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Portal del Administrador</title>

    <%- include('partials/head') %>

</head>


<body>

    <%- include('partials/navegation') %>


        <main class="container mt-5">

            <!-- ENCABEZADO -->

            <div class="text-center mb-5">

                <h1>
                    Portal del Administrador
                </h1>

                <p class="lead">
                    Administración y control del sistema de inspecciones
                </p>

            </div>


            <!-- OPCIONES DEL ADMINISTRADOR -->

            <div class="row">


                <!-- USUARIOS -->

                <div class="col-md-4 mb-4">

                    <div class="card p-4 text-center h-100">

                        <h3>
                            👥
                        </h3>

                        <h4>
                            Gestionar usuarios
                        </h4>

                        <p>
                            Registrar, consultar y administrar los usuarios del sistema.
                        </p>

                        <a href="/gestionar-usuarios" class="btn btn-primary">
                            👥 Gestionar usuarios
                        </a>

                    </div>

                </div>


                <!-- INSPECTORES -->

                <div class="col-md-4 mb-4">

                    <div class="card p-4 text-center h-100">

                        <h3>
                            👷
                        </h3>

                        <h4>
                            Gestionar inspectores
                        </h4>

                        <p>
                            Consultar y administrar la información de los inspectores.
                        </p>

                        <button type="button" class="btn btn-primary">
                            Gestionar inspectores
                        </button>

                    </div>

                </div>


                <!-- INSPECCIONES -->

                <div class="col-md-4 mb-4">

                    <div class="card p-4 text-center h-100">

                        <h3>
                            📋
                        </h3>

                        <h4>
                            Consultar inspecciones
                        </h4>

                        <p>
                            Consultar las inspecciones realizadas por los inspectores.
                        </p>

                        <button type="button" class="btn btn-primary">
                            Consultar inspecciones
                        </button>

                    </div>

                </div>


                <!-- REPORTES -->

                <div class="col-md-4 mb-4">

                    <div class="card p-4 text-center h-100">

                        <h3>
                            📊
                        </h3>

                        <h4>
                            Reportes
                        </h4>

                        <p>
                            Consultar información y generar reportes del sistema.
                        </p>

                        <button type="button" class="btn btn-primary">
                            Ver reportes
                        </button>

                    </div>

                </div>


                <!-- CORTES -->

                <div class="col-md-4 mb-4">

                    <div class="card p-4 text-center h-100">

                        <h3>
                            💰
                        </h3>

                        <h4>
                            Cortes
                        </h4>

                        <p>
                            Consultar y generar los cortes de inspecciones.
                        </p>

                        <button type="button" class="btn btn-primary">
                            Ver cortes
                        </button>

                    </div>

                </div>


                <!-- CONFIGURACIÓN -->

                <div class="col-md-4 mb-4">

                    <div class="card p-4 text-center h-100">

                        <h3>
                            ⚙️
                        </h3>

                        <h4>
                            Configuración
                        </h4>

                        <p>
                            Administrar las opciones generales del sistema.
                        </p>

                        <button type="button" class="btn btn-primary">
                            Configuración
                        </button>

                    </div>

                </div>


            </div>

        </main>


        <%- include('partials/footer') %>

</body>

</html>