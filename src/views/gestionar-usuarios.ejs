<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gestionar usuarios</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <div class="container mt-5">

        <div class="text-center mb-4">
            <h1>Gestionar usuarios</h1>
            <p class="text-muted">
                Administración de usuarios del sistema de inspecciones
            </p>
        </div>

        <!-- BOTÓN REGISTRAR -->
        <div class="mb-4">
            <button class="btn btn-success">
                + Registrar usuario
            </button>
        </div>

        <!-- TABLA DE USUARIOS -->
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">

                    <tr>
                        <th>Usuario</th>
                        <th>Nombre</th>
                        <th>Cargo</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>mfuentes</td>
                        <td>María Fernanda</td>
                        <td>Inspector</td>
                        <td>
                            <span class="badge bg-success">
                                Activo
                            </span>
                        </td>
                        <td>
                            <a href="/detalle-usuario" class="btn btn-primary btn-sm">
                                Ver
                            </a>
                        </td>
                    </tr>

                    <tr>
                        <td>admin01</td>
                        <td>Administrador</td>
                        <td>Administrativo</td>
                        <td>
                            <span class="badge bg-success">
                                Activo
                            </span>
                        </td>
                        <td>
                            <a href="/detalle-usuario" class="btn btn-primary btn-sm">
                                Ver
                            </a>
                        </td>
                    
                    </tr>

                    <tr>
                        <td>tecnico01</td>
                        <td>Carlos</td>
                        <td>Técnico</td>
                        <td>
                            <span class="badge bg-success">
                                Activo
                            </span>
                        </td>
                        <td>
                            <a href="/detalle-usuario" class="btn btn-primary btn-sm">
                                Ver
                            </a>
                        </td>
                    </tr>

                    <tr>
                        <td>cliente01</td>
                        <td>Juan Pérez</td>
                        <td>Cliente</td>
                        <td>
                            <span class="badge bg-secondary">
                                Inactivo
                            </span>
                        </td>
                        <td>
                            <a href="/detalle-usuario" class="btn btn-primary btn-sm">
                                Ver
                            </a>
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

        <!-- VOLVER -->
        <div class="mt-4">
            <a href="/portal-administrativo" class="btn btn-secondary">
                ← Volver al portal
            </a>
        </div>

    </div>

</body>

</html>