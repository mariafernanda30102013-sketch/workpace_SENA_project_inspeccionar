                    </select>
                </div>

                <label> Numero del Documento </label>
                <input type="text" name="numeroDocumento" class="form-control" id="numeroDocumento" placeholder="Digite su documento" required>  
            </div>
            <button type="button" class="btn btn-primary" onclick="siguientePaso(2)">validar / continuar</button>
<div id="paso-2" class="paso-seccion">
<h4>2. datos personales y nombres</h4>
<p class="text-meted"> ingresae sus nombres y apellidos tal como su documento de identificacion </p>

</div class="row">
<div class="col-md-6 mb-3">
    <imput type="text" name="prmerapellido" clss="form-control" id="primerapellido"
    placeholder="digitar su segundo apellidos" required>
</imput>
</div>
</div>


        </form>
    </div>
    <%- include('Partials/footer') %>
