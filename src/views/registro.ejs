```html
<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title_menu %>
    </title>

    <%- include('partials/head') %>

</head>

<body>

    <%- include('partials/navegation') %>

        <main class="container">

            <% if (typeof registroExitoso !== 'undefined' && registroExitoso) { %>

    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <h4 class="alert-heading">✅ Usuario registrado correctamente</h4>

        <p>Los datos llegaron correctamente al servidor.</p>

        <hr>

        <p class="mb-0">
            Ahora puede iniciar sesión.
            <a href="/login" class="btn btn-success btn-sm ms-2">
                Ir al inicio de sesión
            </a>
        </p>
    </div>

<% } %>

            <div class="container mt-5">

                <h1>Bienvenidos - Vista de Creación de Usuario</h1>

                <h2>Gestión de Usuario</h2>

                <form action="/autenticacion/registro" method="post" id="formRegistro">

                    <!-- PASO 1 -->
                    <div id="paso-1" class="paso-seccion">

                        <h4>1. Datos Personales (Identificación)</h4>

                        <div class="mb-3">

                            <label for="tipoDocumento">
                                Tipo de Documento
                            </label>

                            <select name="tipoDocumento" class="form-control" id="tipoDocumento" required>

                                <option value="Cedula">
                                    Cédula de Ciudadanía
                                </option>

                                <option value="Pasaporte">
                                    Pasaporte
                                </option>

                                <option value="TI">
                                    Tarjeta de Identidad
                                </option>

                                <option value="CE">
                                    Cédula de Extranjería
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label for="numeroDocumento">
                                Número del Documento
                            </label>

                            <input type="text" name="numeroDocumento" class="form-control" id="numeroDocumento"
                                placeholder="Digite su documento" required>

                        </div>

                        <button type="button" class="btn btn-primary" onclick="siguientePaso(2)">

                            Validar / Continuar

                        </button>

                    </div>


                    <!-- PASO 2 -->
                    <!-- PASO 2 -->
                    <div id="paso-2" class="paso-seccion" style="display: none;">

                        <h4>2. Datos personales</h4>

                        <p class="text-muted">
                            Ingrese sus nombres y apellidos tal como aparecen
                            en su documento de identificación.
                        </p>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label for="primerNombre">
                                    Primer nombre
                                </label>

                                <input type="text" name="primerNombre" class="form-control" id="primerNombre"
                                    placeholder="Digite su primer nombre" required>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label for="segundoNombre">
                                    Segundo nombre
                                </label>

                                <input type="text" name="segundoNombre" class="form-control" id="segundoNombre"
                                    placeholder="Digite su segundo nombre" required>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label for="primerApellido">
                                    Primer apellido
                                </label>

                                <input type="text" name="primerApellido" class="form-control" id="primerApellido"
                                    placeholder="Digite su primer apellido" required>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label for="segundoApellido">
                                    Segundo apellido
                                </label>

                                <input type="text" name="segundoApellido" class="form-control" id="segundoApellido"
                                    placeholder="Digite su segundo apellido" required>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label for="cargo">
                                    Cargo
                                </label>

                                <select name="cargo" class="form-control" id="cargo" required>

                                    <option value="">
                                        Seleccione su cargo
                                    </option>

                                    <option value="cliente">
                                        Cliente
                                    </option>

                                    <option value="tecnico">
                                        Técnico
                                    </option>

                                    <option value="inspector">
                                        Inspector
                                    </option>

                                    <option value="administrativo">
                                        Administrativo
                                    </option>

                                </select>

                            </div>

                        </div>

                        <button type="button" class="btn btn-secondary" onclick="anteriorPaso(1)">

                            Atrás

                        </button>

                        <button type="button" class="btn btn-primary" onclick="siguientePaso(3)">

                            Continuar

                        </button>

                    </div>


                    <!-- PASO 3 -->
                    <div id="paso-3" class="paso-seccion" style="display: none;">

                        <h4>3. Crear cuenta de usuario</h4>

                        <p class="text-muted">
                            Cree los datos que utilizará para ingresar al sistema.
                        </p>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label for="usuario">
                                    Nombre de usuario
                                </label>

                                <input type="text" name="usuario" class="form-control" id="usuario"
                                    placeholder="Digite su nombre de usuario" required>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label for="correo">
                                    Correo electrónico
                                </label>

                                <input type="email" name="correo" class="form-control" id="correo"
                                    placeholder="Digite su correo electrónico" required>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label for="contrasena">
                                    Contraseña
                                </label>

                                <input type="password" name="contrasena" class="form-control" id="contrasena"
                                    placeholder="Digite su contraseña" required>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label for="confirmarContrasena">
                                    Confirmar contraseña
                                </label>

                                <input type="password" name="confirmarContrasena" class="form-control"
                                    id="confirmarContrasena" placeholder="Repita su contraseña" required>

                            </div>

                        </div>

                        <button type="button" class="btn btn-secondary" onclick="anteriorPaso(2)">

                            Atrás

                        </button>

                        <button type="submit" class="btn btn-success">

                            Crear usuario

                        </button>

                    </div>

                </form>

            </div>

        </main>

        <%- include('partials/footer') %>


            <script>

                function siguientePaso(paso) {

                    if (paso === 2) {

                        document.getElementById('paso-1').style.display = 'none';
                        document.getElementById('paso-2').style.display = 'block';

                    }

                    if (paso === 3) {

                        document.getElementById('paso-2').style.display = 'none';
                        document.getElementById('paso-3').style.display = 'block';

                    }

                }


                function anteriorPaso(paso) {

                    if (paso === 1) {

                        document.getElementById('paso-2').style.display = 'none';
                        document.getElementById('paso-1').style.display = 'block';

                    }

                    if (paso === 2) {

                        document.getElementById('paso-3').style.display = 'none';
                        document.getElementById('paso-2').style.display = 'block';

                    }

                }
            </script>

</body>

</html>